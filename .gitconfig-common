# Shared git config, included by darwin.lnk/.gitconfig and linux.lnk/.gitconfig.
# Platform files hold only binary paths (gh, credential helpers).

[commit]
gpgsign = true

[core]
attributesfile = ~/.gitattributes
editor = true

[diff "bun"]
binary = true
cachetextconv = true
textconv = bun

[fetch]
prune = true

[filter "lfs"]
clean = git-lfs clean -- %f
process = git-lfs filter-process
required = true
smudge = git-lfs smudge -- %f

[gitbutler]
gitbutlerCommitter = 1

[gpg]
format = ssh

[gpg "ssh"]
# Lets `git log --show-signature` verify our own SSH signatures.
allowedSignersFile = ~/.config/git/allowed_signers

[init]
defaultBranch = main

[merge]
conflictStyle = "diff3"

[merge "mergiraf"]
name = mergiraf
driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[mergetool]
keepBackup = true

[pull]
rebase = false

[rerere]
enabled = true

[tag]
forceSignAnnotated = true
gpgsign = true

[user]
name = Griko Nibras
email = griko@nibras.co
# Sign with the key file so no agent is needed; ssh-keygen is git's default.
signingkey = ~/.ssh/id_ed25519
