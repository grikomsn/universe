[include]
path = ~/.gitconfig-common

# Generic helper first: an empty `helper =` resets the list for every URL
# matched after it, so it must precede the github.com overrides below.
[credential]
helper =
helper = /usr/local/share/gcm-core/git-credential-manager

[credential "https://dev.azure.com"]
useHttpPath = true

[credential "https://gist.github.com"]
helper =
helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://git.cafe"]
helper =
helper = !~/.bun/bin/bun ~/.bun/bin/cafe auth http credential --host git.cafe
useHttpPath = true

[credential "https://github.com"]
helper =
helper = !/opt/homebrew/bin/gh auth git-credential

# Last, so ~/.gitconfig-private (machine-local settings) overrides the above.
[include]
path = ~/.gitconfig-private
