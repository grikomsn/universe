[include]
path = ~/.gitconfig-common

[core]
hooksPath = ~/.githooks

# Generic helper first: an empty `helper =` resets the list for every URL
# matched after it, so it must precede the github.com overrides below.
[credential]
helper =
helper = git-credential-manager

[credential "https://dev.azure.com"]
useHttpPath = true

[credential "https://gist.github.com"]
helper =
helper = !/usr/bin/gh auth git-credential

[credential "https://github.com"]
helper =
helper = !/usr/bin/gh auth git-credential

[gpg "ssh"]
program = "/opt/1Password/op-ssh-sign"

# Last, so ~/.gitconfig-private (e.g. `git-signing local`) overrides the above.
[include]
path = ~/.gitconfig-private
