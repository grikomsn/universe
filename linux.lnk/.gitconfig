[include]
path = ~/.gitconfig-common

[core]
hooksPath = ~/.githooks

# No generic credential helper: Git Credential Manager is not packaged for
# Fedora, so only GitHub (via gh) has one.

[credential "https://gist.github.com"]
helper =
helper = !/usr/bin/gh auth git-credential

[credential "https://github.com"]
helper =
helper = !/usr/bin/gh auth git-credential

[gpg "ssh"]
program = "/opt/1Password/op-ssh-sign"

# Last, so ~/.gitconfig-private (e.g. `git-signing local`) overrides the above.
[include]
path = ~/.gitconfig-private
