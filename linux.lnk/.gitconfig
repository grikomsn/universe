[include]
path = ~/.gitconfig-common

[core]
hooksPath = ~/.githooks

# No generic credential helper: Git Credential Manager is not packaged for
# Fedora, so only GitHub (via gh) has one.

[credential "https://gist.github.com"]
helper =
helper = !/usr/bin/gh auth git-credential

[credential "https://git.cafe"]
helper =
helper = !~/.bun/bin/bun ~/.bun/bin/cafe auth http credential --host git.cafe
useHttpPath = true

[credential "https://github.com"]
helper =
helper = !/usr/bin/gh auth git-credential

# Last, so ~/.gitconfig-private (machine-local settings) overrides the above.
[include]
path = ~/.gitconfig-private
