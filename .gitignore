__pycache__
.config/fish/fish_variables
.DS_Store
.npmrc
.turbo
.vercel
*.bak
*.env*
*.log*
*.tsbuildinfo
node_modules

# skills-CLI-managed: restored from .agents/.skill-lock.json via scripts/skills-restore.sh
# rex is a version-independent stub from `rex skill setup` (not a skills-CLI
# source), so keep it tracked to restore it everywhere; fleet is
# hand-written for managing the machine fleet; lulu-cleanup is hand-written
.agents/skills/*
!.agents/skills/rex
!.agents/skills/fleet
!.agents/skills/lulu-cleanup

# fleet's private inventory (real hostnames, tailnet names, machine notes);
# fleet.example.toml is the tracked, sanitized copy
fleet/fleet.toml
# fleet skill backups of edited files; can hold private or secret values
*.bak-fleet-*

!.env.example

# generated by scripts/completions.sh (and tool installers); acli has no
# generator left, so its completion stays tracked
.config/fish/completions/*
!.config/fish/completions/acli.fish
