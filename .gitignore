__pycache__
.config/fish/fish_variables
.DS_Store
.npmrc
.turbo
.vercel
*.bak
*.env*
*.log*
*.tsbuildinfo
node_modules

# skills-CLI-managed: restored from .agents/.skill-lock.json via scripts/skills-restore.sh
# rex is a version-independent stub from `rex skill setup` (not a skills-CLI
# source), so keep it tracked to restore it everywhere
.agents/skills/*
!.agents/skills/rex

# fleet entrypoint skills (herdr skill is generated via `herdr --skill`;
# fleet-boxes-sync-mcp is hand-written), keep them tracked
fleet/.agents/skills/*
!fleet/.agents/skills/boxes-sync-mcp
!fleet/.agents/skills/herdr

!.env.example

# generated by scripts/completions.sh (and tool installers); acli has no
# generator left, so its completion stays tracked
.config/fish/completions/*
!.config/fish/completions/acli.fish
