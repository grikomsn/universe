__pycache__
.config/fish/fish_variables
.DS_Store
.npmrc
.turbo
.vercel
*.bak
*.env*
*.log*
*.tsbuildinfo
node_modules

# skills-CLI-managed: restored from .agents/.skill-lock.json via scripts/skills-restore.sh
# rex is a version-independent stub from `rex skill setup` (not a skills-CLI
# source), so keep it tracked to restore it everywhere; fleet is
# hand-written for managing the machine fleet
.agents/skills/*
!.agents/skills/rex
!.agents/skills/fleet

!.env.example

# generated by scripts/completions.sh (and tool installers); acli has no
# generator left, so its completion stays tracked
.config/fish/completions/*
!.config/fish/completions/acli.fish
